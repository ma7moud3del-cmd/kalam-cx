# Cloudflare Pages response headers. GENERATED by build_platform.py from platform/app/_headers in the builder repo:
# change it there, not in the site repo. {{...}} parts are filled in by the build.
# Pages applies these to the site's files. The video/PDF function (functions/_media.js) sets its own headers.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-YWVa2gRJKJ2/7W2bSClXO8PpiQt62on9t8cJ78R3W+Q='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; media-src 'self'; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; worker-src 'none'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=(), autoplay=(self "https://www.youtube-nocookie.com"), fullscreen=(self "https://www.youtube-nocookie.com"), picture-in-picture=(self "https://www.youtube-nocookie.com"), encrypted-media=(self "https://www.youtube-nocookie.com")
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  ! Access-Control-Allow-Origin
  X-Robots-Tag: noindex

# Preview copies (https://<branch or id>.kalam-learning.pages.dev) are never indexed, whatever the setting.
https://:version.kalam-learning.pages.dev/*
  X-Robots-Tag: noindex

# Code, styles and fonts: every address carries the release version (?v=...) or a version in the file name,
# so a new release is a new address. Browsers keep them for a year and never re-check.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pictures keep the same name when replaced: one day fresh, then refreshed in the background.
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/courses/*/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Practice workbooks: re-checked every hour.
/courses/*/files/*
  Cache-Control: public, max-age=3600

# index.html, 404.html, data/catalog.json and course.json keep Cloudflare's default
# (public, max-age=0, must-revalidate): a new release is seen on the next visit.
